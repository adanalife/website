source 'https://rubygems.org'

# the static website generator
gem 'middleman', '~> 4.6'

# this extension adds blog-specific functionality
gem 'middleman-blog'

# for making development easier
gem 'middleman-livereload'

# for automatically generating a sitemap
gem 'middleman-search_engine_sitemap'

# for syntax highlighting
gem 'middleman-syntax'

# for dynamically generating page titles
gem 'middleman-title'

# this will remove whitespace around HTML files
gem 'middleman-minify-html'

# for generating pretty FB link previews
gem 'middleman-ogp'

# for generating article summaries
gem 'nokogiri'

# For feed.xml.builder
gem 'builder'

# For parsing Markdown
gem 'redcarpet'

# For suggesting alt text at image ingest (script/ingest-image)
gem 'anthropic'
