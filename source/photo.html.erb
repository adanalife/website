---
pageable: false
---
<% content_for :title do %>Photo: <%= File.basename(photo.destination_path) %><% end %>

<section>
  <p>
    You're now viewing the <em>super high-resolution</em> version of this image.<br>
    <a href='/contact'>Contact me</a> if you'd like to use it, it's probably fine!
  </p>
  <p>
    <a href="javascript:history.back()" class='hidden'>Click here to go back</a>
  </p>

  <a href="/<%= photo.destination_path %>" class='no-underline'>
    <%= image_tag photo.destination_path, class: 'really-wide' %>
  </a>

  <%= partial 'share_buttons' %>

</section>

<script>
  // show back buttons if and only if we came from this site
  if(document.referrer.includes('dana.lol')) {
    var back_buttons = document.getElementsByClassName('hidden');
    for (i=0; i < back_buttons.length; i++) {
      back_buttons[i].classList.remove('hidden');
    }
  }
</script>
